# Copy to .env and adjust. docker-compose reads this file automatically.

# Shared secret for the control plane and ML service.
# Required in any deployment; the services warn loudly when it is unset.
# Generate one with: openssl rand -hex 32
API_KEY=change-me

# Where the browser reaches the control plane. Baked into the dashboard bundle
# at BUILD time (Next.js inlines NEXT_PUBLIC_*), so changing it needs a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:4000

# HTTP Basic Auth wall in front of the dashboard. Leave both blank to disable.
#
# Set these for any deployment reachable from the internet: API_KEY is inlined
# into the client bundle, so it is readable by anyone who can load the page.
# Gating the dashboard is what keeps that key from becoming public.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Escape hatch for running with auth disabled. Without it, api and ml exit at
# startup when API_KEY is unset, and a production dashboard build with no
# BASIC_AUTH_* serves 503. docker-compose.yml sets it for local runs.
# ALLOW_UNAUTHENTICATED=true
