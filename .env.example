# Copy to .env and adjust. docker-compose reads this file automatically.

# Shared secret for the control plane and ML service.
# Required in any deployment; the services warn loudly when it is unset.
API_KEY=change-me

# Where the browser reaches the control plane. Baked into the dashboard bundle
# at BUILD time (Next.js inlines NEXT_PUBLIC_*), so changing it needs a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:4000
