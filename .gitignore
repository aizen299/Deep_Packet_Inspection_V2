# ==============================

backend/build/
backend/build-asan/
backend/output/
backend/bin/
backend/CMakeFiles/
backend/CMakeCache.txt
backend/Makefile

# ==============================
# Uploaded / Generated PCAPs
# ==============================

backend/api/uploads/
*.pcap
test_dpi.pcap
extreme_traffic.pcap

# Captures dropped into the data dir (extensionless multer temp names land here
# too). Everything is ignored except the checked-in sample.
backend/data/*
!backend/data/sample.pcap

# Stale generated report served from the dashboard's static dir.
dashboard/public/stats.json

# ==============================
# Generated JSON (engine reports, stats)
# ==============================
#
# NOTE: this used to be a blanket `*.json`, which silently excluded every
# package.json / package-lock.json / tsconfig.json in the repo and left both
# Docker images unbuildable from a clean clone. Ignore the generated files by
# name instead, and keep the negations below as a backstop.

backend/*.json
backend/stats.json
*.log

!package.json
!package-lock.json
!tsconfig.json
!next.config.json
!eslint.config.json
!docker-compose.json

